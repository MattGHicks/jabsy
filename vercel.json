{
  "framework": "nextjs",
  "headers": [
    {
      "source": "/clear-cache",
      "headers": [
        {
          "key": "Clear-Site-Data",
          "value": "\"cache\", \"storage\""
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync-cards",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/live-results",
      "schedule": "* * * * *"
    }
  ]
}
